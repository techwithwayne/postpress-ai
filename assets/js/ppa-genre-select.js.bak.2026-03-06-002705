/* PostPress AI — Genre Select Enhancer
 * Native <select> + Search + Favorites + Recent (localStorage)
 *
 * Targets:
 * - select[data-ppa-genre-select="1"]  (preferred)
 * - #ppa-genre                         (fallback)
 *
 * Notes:
 * - Additive UI only (admin.js still owns payload + requests).
 * - Uses localStorage when available; silently degrades if blocked.
 */
(function () {
	"use strict";

	const LS_RECENT_KEY = "ppa_genre_recent_v1";
	const LS_FAV_KEY = "ppa_genre_favs_v1";
	const MAX_RECENT = 8;

	function safeGetStorage(key, fallback) {
		try {
			if (!window.localStorage) return fallback;
			const raw = window.localStorage.getItem(key);
			if (!raw) return fallback;
			const parsed = JSON.parse(raw);
			return parsed ?? fallback;
		} catch (e) {
			return fallback;
		}
	}

	function safeSetStorage(key, value) {
		try {
			if (!window.localStorage) return;
			window.localStorage.setItem(key, JSON.stringify(value));
		} catch (e) {
			// localStorage disabled; silently degrade
		}
	}

	function uniqPreserveOrder(arr) {
		const seen = new Set();
		const out = [];
		for (const x of arr) {
			if (!x || seen.has(x)) continue;
			seen.add(x);
			out.push(x);
		}
		return out;
	}

	function getRecent() {
		return safeGetStorage(LS_RECENT_KEY, []);
	}

	function setRecent(list) {
		const clean = uniqPreserveOrder(list).slice(0, MAX_RECENT);
		safeSetStorage(LS_RECENT_KEY, clean);
	}

	function getFavs() {
		return safeGetStorage(LS_FAV_KEY, []);
	}

	function setFavs(list) {
		const clean = uniqPreserveOrder(list);
		safeSetStorage(LS_FAV_KEY, clean);
	}

	function optionToData(optionEl, groupLabel) {
		return {
			value: optionEl.value,
			label: optionEl.textContent || "",
			group: groupLabel || "",
			disabled: !!optionEl.disabled,
		};
	}

	function snapshotSelect(selectEl) {
		// Captures original option order + optgroups (if present)
		const data = [];
		const children = Array.from(selectEl.children);
		const hasOptgroups = children.some((c) => c.tagName === "OPTGROUP");

		if (hasOptgroups) {
			for (const child of children) {
				if (child.tagName === "OPTGROUP") {
					const groupLabel = child.label || "";
					const opts = Array.from(child.querySelectorAll("option"));
					for (const opt of opts) data.push(optionToData(opt, groupLabel));
				} else if (child.tagName === "OPTION") {
					data.push(optionToData(child, ""));
				}
			}
		} else {
			const opts = Array.from(selectEl.querySelectorAll("option"));
			for (const opt of opts) data.push(optionToData(opt, ""));
		}

		return data;
	}

	function buildOptgroup(label, options, selectedValue) {
		const og = document.createElement("optgroup");
		og.label = label;

		for (const d of options) {
			const opt = document.createElement("option");
			opt.value = d.value;
			opt.textContent = d.label;
			opt.disabled = !!d.disabled;
			if (selectedValue !== null && opt.value === selectedValue) opt.selected = true;
			og.appendChild(opt);
		}

		return og;
	}

	function rebuildSelect(selectEl, baseData, query, favs, recent) {
		const selectedValue = selectEl.value;
		const q = (query || "").trim().toLowerCase();

		// Filter base data by query; always keep selected visible (even if it doesn't match query)
		let filteredBase = q
			? baseData.filter((d) => (d.label || "").toLowerCase().includes(q))
			: baseData.slice();

		const byValue = new Map();
		for (const d of baseData) byValue.set(d.value, d);

		const selectedData = selectedValue ? byValue.get(selectedValue) : null;
		const selectedVisible =
			!q ||
			(selectedData && (selectedData.label || "").toLowerCase().includes(q)) ||
			filteredBase.some((d) => d.value === selectedValue);

		if (q && selectedData && !selectedVisible) {
			// Inject selected into filtered list so it never “disappears” mid-search
			filteredBase = [selectedData, ...filteredBase];
		}

		const favOptions = favs
			.map((v) => byValue.get(v))
			.filter(Boolean)
			.filter((d) => (q ? (d.label || "").toLowerCase().includes(q) : true));

		const recentOptions = recent
			.map((v) => byValue.get(v))
			.filter(Boolean)
			.filter((d) => (q ? (d.label || "").toLowerCase().includes(q) : true))
			.filter((d) => !favs.includes(d.value));

		// Group remaining options by original group label (preserve order)
		const grouped = new Map();
		const alreadyUsed = new Set();
		for (const d of favOptions) alreadyUsed.add(d.value);
		for (const d of recentOptions) alreadyUsed.add(d.value);

		for (const d of filteredBase) {
			// Keep Auto as a top-level option, not duplicated
			if (d.value === "") continue;
			if (alreadyUsed.has(d.value)) continue;

			const groupLabel = d.group || "";
			if (!grouped.has(groupLabel)) grouped.set(groupLabel, []);
			grouped.get(groupLabel).push(d);
		}

		// Wipe + rebuild
		selectEl.innerHTML = "";

		// Auto at top (if present)
		const auto = baseData.find((d) => d.value === "");
		if (auto) {
			const autoOpt = document.createElement("option");
			autoOpt.value = auto.value;
			autoOpt.textContent = auto.label;
			if (selectedValue === "") autoOpt.selected = true;
			selectEl.appendChild(autoOpt);
		}

		// If searching and selected doesn’t match, show it clearly
		if (q && selectedData && selectedData.value && !((selectedData.label || "").toLowerCase().includes(q))) {
			selectEl.appendChild(buildOptgroup("Selected", [selectedData], selectedValue));
		}

		if (favOptions.length) {
			selectEl.appendChild(buildOptgroup("★ Favorites", favOptions, selectedValue));
		}

		if (recentOptions.length) {
			selectEl.appendChild(buildOptgroup("Recent", recentOptions, selectedValue));
		}

		// Original groups
		for (const [groupLabel, options] of grouped.entries()) {
			if (!groupLabel) {
				for (const d of options) {
					const opt = document.createElement("option");
					opt.value = d.value;
					opt.textContent = d.label;
					opt.disabled = !!d.disabled;
					if (opt.value === selectedValue) opt.selected = true;
					selectEl.appendChild(opt);
				}
			} else {
				selectEl.appendChild(buildOptgroup(groupLabel, options, selectedValue));
			}
		}

		// Restore selection if still present
		if (selectedValue !== null && selectedValue !== undefined) {
			selectEl.value = selectedValue;
		}
	}

	function makeEnhancer(selectEl) {
		const baseData = snapshotSelect(selectEl);

		// Build minimal toolbar (no CSS dependency)
		const tools = document.createElement("div");
		tools.className = "ppa-genre-tools";

		const search = document.createElement("input");
		search.type = "search";
		search.className = "ppa-genre-search";
		search.placeholder = "Search genres…";
		search.autocomplete = "off";
		search.setAttribute("aria-label", "Search genres");

		// Use Composer button classes if present; harmless if not styled
		const btnFav = document.createElement("button");
		btnFav.type = "button";
		btnFav.className = "ppa-btn ppa-btn-secondary ppa-genre-fav";
		btnFav.textContent = "☆"; // toggles to ★ when favored
		btnFav.title = "Toggle favorite";

		const btnClear = document.createElement("button");
		btnClear.type = "button";
		btnClear.className = "ppa-btn ppa-btn-secondary ppa-genre-clear";
		btnClear.textContent = "Clear";
		btnClear.title = "Clear search";

		// Insert tools directly before select (inside same form-group)
		selectEl.parentNode.insertBefore(tools, selectEl);
		tools.appendChild(search);
		tools.appendChild(btnFav);
		tools.appendChild(btnClear);

		function refreshFavButton() {
			const v = selectEl.value;
			const favs = getFavs();
			const isFav = !!v && v !== "" && favs.includes(v);
			btnFav.textContent = isFav ? "★" : "☆";
			btnFav.setAttribute("aria-pressed", isFav ? "true" : "false");
		}

		function rerender() {
			const favs = getFavs();
			const recent = getRecent();
			rebuildSelect(selectEl, baseData, search.value, favs, recent);
			refreshFavButton();
		}

		search.addEventListener("input", rerender);

		btnClear.addEventListener("click", function () {
			search.value = "";
			rerender();
			search.focus();
		});

		btnFav.addEventListener("click", function () {
			const v = selectEl.value;
			if (!v) return;

			const favs = getFavs();
			const idx = favs.indexOf(v);
			if (idx >= 0) favs.splice(idx, 1);
			else favs.unshift(v);

			setFavs(favs);
			rerender();
		});

		selectEl.addEventListener("change", function () {
			const v = selectEl.value;
			if (!v) {
				refreshFavButton();
				return;
			}

			const recent = getRecent();
			recent.unshift(v);
			setRecent(recent);
			refreshFavButton();
		});

		// Initial render
		rerender();
	}

	document.addEventListener("DOMContentLoaded", function () {
		// Preferred: explicit data attribute
		let selects = Array.from(document.querySelectorAll('select[data-ppa-genre-select="1"]'));

		// Fallback for fast testing before markup changes land
		if (!selects.length) {
			const fallback = document.getElementById("ppa-genre");
			if (fallback && fallback.tagName === "SELECT") selects = [fallback];
		}

		if (!selects.length) return;

		for (const sel of selects) {
			// Prevent double-init
			if (sel.dataset && sel.dataset.ppaGenreEnhanced === "1") continue;
			if (sel.dataset) sel.dataset.ppaGenreEnhanced = "1";

			// If tools already exist (manual insert), skip
			try {
				if (sel.parentNode && sel.parentNode.querySelector(".ppa-genre-tools")) continue;
			} catch (e0) {}

			makeEnhancer(sel);
		}
	});
})();


// --- PostPress AI: hide native genre dropdown when enhancer UI is present ---
(function () {
  function ppaHasGenreEnhancer() {
    // The enhancer input uses this placeholder on prod
    return !!document.querySelector('input[placeholder*="Search genres"]');
  }

  function ppaHideNativeGenreSelect() {
    try {
      var sel = document.getElementById('ppa-genre');
      if (!sel) return;
      if (!ppaHasGenreEnhancer()) return; // keep native select as fallback if enhancer fails
      sel.style.display = 'none';
    } catch (e) {}
  }

  document.addEventListener('DOMContentLoaded', function () {
    ppaHideNativeGenreSelect();
    setTimeout(ppaHideNativeGenreSelect, 150);
    setTimeout(ppaHideNativeGenreSelect, 600);
    setTimeout(ppaHideNativeGenreSelect, 1200);
  });
})();

// ============================================================================
// PPA GENRE ENHANCER V2
// - Makes the Genre control self-explanatory
// - "Select" button shows genres (fixes "★ shows nothing")
// - Typing filters list; click result selects underlying #ppa-genre
// ============================================================================
(function () {
  if (window.__ppaGenreEnhancerV2) return;
  window.__ppaGenreEnhancerV2 = true;

  function text(x) { return (x || '').toString().trim(); }

  function findAutoValue(sel) {
    if (!sel || !sel.options) return '';
    for (var i = 0; i < sel.options.length; i++) {
      var opt = sel.options[i];
      if (text(opt.textContent).toLowerCase() === 'auto') return opt.value;
    }
    return sel.options.length ? sel.options[0].value : '';
  }

  function buildGenreList(sel) {
    if (!sel || !sel.options) return [];
    var out = [];
    for (var i = 0; i < sel.options.length; i++) {
      var opt = sel.options[i];
      var label = text(opt.textContent);
      if (!label) continue;
      out.push({ value: opt.value, label: label });
    }
    return out;
  }

  function closestContainer(el) {
    if (!el) return null;
    return el.closest('.ppa-field') || el.closest('.ppa-form-group') || el.parentElement;
  }

  function getButtons(container) {
    if (!container) return [];
    return Array.prototype.slice.call(container.querySelectorAll('button'));
  }

  function pickSelectButton(btns) {
    // Prefer the existing ★ button if present
    for (var i = 0; i < btns.length; i++) {
      var t = text(btns[i].textContent);
      if (t === '★' || t.indexOf('★') !== -1) return btns[i];
    }
    // Fallback: first button in the group
    return btns.length ? btns[0] : null;
  }

  function pickClearButton(btns) {
    for (var i = 0; i < btns.length; i++) {
      if (text(btns[i].textContent).toLowerCase() === 'clear') return btns[i];
    }
    return null;
  }

  function ensureHelpLine(container, input) {
    if (!container || !input) return null;
    if (container.querySelector('.ppa-genre-help-v2')) return container.querySelector('.ppa-genre-help-v2');

    var help = document.createElement('div');
    help.className = 'ppa-genre-help-v2';
    help.style.marginTop = '6px';
    help.style.fontSize = '12px';
    help.style.opacity = '0.85';
    help.textContent = 'Optional. Genre is the marketing angle (How-to, Guide, Listicle). If you are not sure, leave Auto.';
    input.insertAdjacentElement('afterend', help);
    return help;
  }

  function ensureList(container) {
    if (!container) return null;
    var existing = container.querySelector('.ppa-genre-list-v2');
    if (existing) return existing;

    var box = document.createElement('div');
    box.className = 'ppa-genre-list-v2';
    box.style.position = 'relative';
    box.style.marginTop = '8px';

    var panel = document.createElement('div');
    panel.className = 'ppa-genre-panel-v2';
    panel.style.position = 'absolute';
    panel.style.left = '0';
    panel.style.right = '0';
    panel.style.top = '0';
    panel.style.zIndex = '9999';
    panel.style.maxHeight = '240px';
    panel.style.overflowY = 'auto';
    panel.style.borderRadius = '10px';
    panel.style.border = '1px solid rgba(255,255,255,0.10)';
    panel.style.background = 'rgba(10,10,10,0.92)';
    panel.style.boxShadow = '0 10px 30px rgba(0,0,0,0.55)';
    panel.style.display = 'none';

    box.appendChild(panel);
    container.appendChild(box);
    return panel;
  }

  function render(panel, items, onPick) {
    if (!panel) return;
    panel.innerHTML = '';
    if (!items.length) {
      var empty = document.createElement('div');
      empty.style.padding = '10px 12px';
      empty.style.opacity = '0.85';
      empty.textContent = 'No matches.';
      panel.appendChild(empty);
      return;
    }

    for (var i = 0; i < items.length; i++) {
      (function (item) {
        var row = document.createElement('div');
        row.style.padding = '10px 12px';
        row.style.cursor = 'pointer';
        row.style.borderBottom = '1px solid rgba(255,255,255,0.06)';
        row.textContent = item.label;

        row.addEventListener('mouseenter', function () {
          row.style.background = 'rgba(255,255,255,0.06)';
        });
        row.addEventListener('mouseleave', function () {
          row.style.background = 'transparent';
        });
        row.addEventListener('click', function () { onPick(item); });

        panel.appendChild(row);
      })(items[i]);
    }
  }

  function init() {
    var sel = document.getElementById('ppa-genre');
    if (!sel) return;

    var input = document.querySelector('input[placeholder*="Search genres"]');
    if (!input) return;

    var container = closestContainer(input);
    if (!container) return;

    var panel = ensureList(container);
    ensureHelpLine(container, input);

    var btns = getButtons(container);
    var selectBtn = pickSelectButton(btns);
    var clearBtn = pickClearButton(btns);

    // Make the star button obvious
    if (selectBtn) {
      selectBtn.textContent = 'Select';
      selectBtn.title = 'Show genres';
      selectBtn.setAttribute('aria-label', 'Show genres');
    }

    var genres = buildGenreList(sel);
    var autoValue = findAutoValue(sel);

    function show(items) {
      if (!panel) return;
      render(panel, items, function (picked) {
        sel.value = picked.value;
        sel.dispatchEvent(new Event('change', { bubbles: true }));
        input.value = '';
        hide();
      });
      panel.style.display = 'block';
    }

    function hide() {
      if (!panel) return;
      panel.style.display = 'none';
    }

    function filter(q) {
      q = text(q).toLowerCase();
      if (!q) return genres.slice(0, 30);
      var out = [];
      for (var i = 0; i < genres.length; i++) {
        if (genres[i].label.toLowerCase().indexOf(q) !== -1) out.push(genres[i]);
        if (out.length >= 30) break;
      }
      return out;
    }

    input.addEventListener('focus', function () {
      show(filter(input.value));
    });

    input.addEventListener('input', function () {
      show(filter(input.value));
    });

    input.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') hide();
      if (e.key === 'Enter') {
        e.preventDefault();
        var list = filter(input.value);
        if (list.length) {
          sel.value = list[0].value;
          sel.dispatchEvent(new Event('change', { bubbles: true }));
          input.value = '';
          hide();
        }
      }
    });

    if (selectBtn) {
      selectBtn.addEventListener('click', function (e) {
        e.preventDefault();
        if (panel && panel.style.display === 'block') hide();
        else show(filter(input.value));
      });
    }

    if (clearBtn) {
      clearBtn.title = 'Reset Genre to Auto';
      clearBtn.addEventListener('click', function (e) {
        e.preventDefault();
        sel.value = autoValue;
        sel.dispatchEvent(new Event('change', { bubbles: true }));
        input.value = '';
        hide();
      });
    }

    // Close list when clicking outside
    document.addEventListener('click', function (e) {
      if (!panel) return;
      if (container.contains(e.target)) return;
      hide();
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    init();
    setTimeout(init, 300);
    setTimeout(init, 900);
  });
})();

// ============================================================================
// PPA GENRE ENHANCER V3 (hardening)
// - Dropdown renders in document.body (cannot be clipped)
// - Select button click captured (cannot be swallowed)
// - Reads genres from #ppa-genre <option> list, updates that select on pick
// ============================================================================
(function () {
  if (window.__ppaGenreEnhancerV3) return;
  window.__ppaGenreEnhancerV3 = true;

  function t(x) { return (x || '').toString().trim(); }

  function getSel() { return document.getElementById('ppa-genre'); }
  function getInput() { return document.querySelector('input[placeholder*="Search genres"]'); }

  function listGenres(sel) {
    var out = [];
    if (!sel || !sel.options) return out;
    for (var i = 0; i < sel.options.length; i++) {
      var opt = sel.options[i];
      var label = t(opt.textContent);
      if (!label) continue;
      out.push({ value: opt.value, label: label });
    }
    return out;
  }

  function findAuto(sel) {
    if (!sel || !sel.options) return '';
    for (var i = 0; i < sel.options.length; i++) {
      if (t(sel.options[i].textContent).toLowerCase() === 'auto') return sel.options[i].value;
    }
    return sel.options.length ? sel.options[0].value : '';
  }

  // Create / reuse floating panel in body
  function ensurePanel() {
    var p = document.getElementById('ppa-genre-panel-v3');
    if (p) return p;

    p = document.createElement('div');
    p.id = 'ppa-genre-panel-v3';
    p.style.position = 'fixed';
    p.style.zIndex = '2147483647';
    p.style.display = 'none';
    p.style.maxHeight = '280px';
    p.style.overflowY = 'auto';
    p.style.borderRadius = '10px';
    p.style.border = '1px solid rgba(255,255,255,0.10)';
    p.style.background = 'rgba(10,10,10,0.94)';
    p.style.boxShadow = '0 10px 30px rgba(0,0,0,0.55)';
    p.style.padding = '0';
    p.style.margin = '0';

    document.body.appendChild(p);
    return p;
  }

  function positionPanel(panel, anchorEl) {
    var r = anchorEl.getBoundingClientRect();
    panel.style.left = Math.round(r.left) + 'px';
    panel.style.top = Math.round(r.bottom + 6) + 'px';
    panel.style.width = Math.round(r.width) + 'px';
  }

  function render(panel, items, onPick) {
    panel.innerHTML = '';
    if (!items.length) {
      var empty = document.createElement('div');
      empty.style.padding = '10px 12px';
      empty.style.opacity = '0.85';
      empty.textContent = 'No genres found. (Try refresh.)';
      panel.appendChild(empty);
      return;
    }

    for (var i = 0; i < items.length; i++) {
      (function (it) {
        var row = document.createElement('div');
        row.style.padding = '10px 12px';
        row.style.cursor = 'pointer';
        row.style.borderBottom = '1px solid rgba(255,255,255,0.06)';
        row.textContent = it.label;

        row.addEventListener('mouseenter', function () { row.style.background = 'rgba(255,255,255,0.06)'; });
        row.addEventListener('mouseleave', function () { row.style.background = 'transparent'; });
        row.addEventListener('click', function (e) {
          e.preventDefault();
          onPick(it);
        });

        panel.appendChild(row);
      })(items[i]);
    }
  }

  function init() {
    var sel = getSel();
    var input = getInput();
    if (!sel || !input) return;

    // Ensure helper microcopy under Genre search input
    if (!document.querySelector('.ppa-genre-help-v3')) {
      var help = document.createElement('div');
      help.className = 'ppa-genre-help-v3';
      help.style.marginTop = '6px';
      help.style.fontSize = '12px';
      help.style.opacity = '0.85';
      help.textContent = 'Optional. Genre is the marketing angle (How-to, Guide, Listicle). If you are not sure, leave Auto.';
      input.insertAdjacentElement('afterend', help);
    }

    // Find the two buttons near the input (Select + Clear)
    var container = input.closest('.ppa-field') || input.closest('.ppa-form-group') || input.parentElement;
    var btns = container ? Array.prototype.slice.call(container.querySelectorAll('button')) : [];
    var selectBtn = null, clearBtn = null;

    for (var i = 0; i < btns.length; i++) {
      var label = t(btns[i].textContent).toLowerCase();
      if (label === 'clear') clearBtn = btns[i];
      if (label === 'select' || label.indexOf('★') !== -1) selectBtn = btns[i];
    }
    if (selectBtn) {
      selectBtn.textContent = 'Select';
      selectBtn.id = 'ppa-genre-select-btn';
      selectBtn.type = 'button';
      selectBtn.title = 'Show genres';
    }
    if (clearBtn) {
      clearBtn.id = 'ppa-genre-clear-btn';
      clearBtn.type = 'button';
      clearBtn.title = 'Reset Genre to Auto';
    }

    var panel = ensurePanel();
    var autoVal = findAuto(sel);

    function filter(q) {
      var all = listGenres(sel);
      q = t(q).toLowerCase();
      if (!q) return all.slice(0, 40);
      var out = [];
      for (var i = 0; i < all.length; i++) {
        if (all[i].label.toLowerCase().indexOf(q) !== -1) out.push(all[i]);
        if (out.length >= 40) break;
      }
      return out;
    }

    function open() {
      positionPanel(panel, input);
      render(panel, filter(input.value), function (picked) {
        sel.value = picked.value;
        sel.dispatchEvent(new Event('change', { bubbles: true }));
        input.value = '';
        close();
      });
      panel.style.display = 'block';
      console.log('[PPA Genre V3] opened list with', panel.children.length, 'rows');
    }

    function close() {
      panel.style.display = 'none';
    }

    // Open on focus + typing
    input.addEventListener('focus', open);
    input.addEventListener('input', open);
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') close();
      if (e.key === 'Enter') {
        e.preventDefault();
        var items = filter(input.value);
        if (items.length) {
          sel.value = items[0].value;
          sel.dispatchEvent(new Event('change', { bubbles: true }));
          input.value = '';
          close();
        }
      }
    });

    // CAPTURE-phase click handlers so nothing else can swallow it
    document.addEventListener('click', function (e) {
      var tgt = e.target;

      if (tgt && tgt.id === 'ppa-genre-select-btn') {
        e.preventDefault(); e.stopPropagation();
        open();
        return;
      }

      if (tgt && tgt.id === 'ppa-genre-clear-btn') {
        e.preventDefault(); e.stopPropagation();
        sel.value = autoVal;
        sel.dispatchEvent(new Event('change', { bubbles: true }));
        input.value = '';
        close();
        return;
      }

      // Click outside closes
      if (panel.style.display === 'block') {
        if (tgt === panel || panel.contains(tgt) || tgt === input) return;
        close();
      }
    }, true);

    // Reposition on scroll/resize while open
    window.addEventListener('scroll', function () { if (panel.style.display === 'block') positionPanel(panel, input); }, true);
    window.addEventListener('resize', function () { if (panel.style.display === 'block') positionPanel(panel, input); });

    console.log('[PPA Genre V3] initialized');
  }

  document.addEventListener('DOMContentLoaded', function () {
    init();
    setTimeout(init, 350);
    setTimeout(init, 900);
  });
})();

/* --- PPA UI cleanup + tooltips (LAW hotfix) --- */
(function(){
  if (window.__ppaUiCleanTooltipsInit) return;
  window.__ppaUiCleanTooltipsInit = true;

  function ready(fn){
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn);
    else fn();
  }

  function norm(t){
    return (t || '')
      .replace(/\?/g,'')
      .replace(/\s+/g,' ')
      .replace(/\s*:\s*$/,'')
      .trim()
      .toLowerCase();
  }

  function getHelp(label){
    var k = norm(label)
      .replace(/[()]/g,'')
      .replace(/[\/]/g,' ')
      .replace(/\s+/g,' ')
      .trim();

    var map = {
      'industry': 'Optional. Adds context so the AI uses better examples, language, and objections.',
      'subject title': 'What the post is about. Be specific (topic + outcome).',
      'target audience': 'Who this is for. Helps the AI pick the right tone, examples, and level of detail.',
      'genre select': 'Optional. Marketing angle (How-to, Guide, Listicle). If you are not sure, leave Auto.',
      'genre': 'Optional. Marketing angle (How-to, Guide, Listicle). If you are not sure, leave Auto.',
      'tone': 'Optional. Leave Auto unless you need a specific vibe.',
      'word count preview': 'Default: 800. Minimum: 300. Maximum: 1,200.',
      'optional brief extra instructions': 'Optional. Add constraints, links, and must-follow details.',
      'advanced optional': 'Optional. Extra settings for power users.',
      'language': 'Choose what language the preview should be written in.',
      'show outline': 'When enabled, the preview includes an outline for faster scanning.'
    };

    return map[k] || ('Info for: ' + label);
  }

  ready(function(){
    try {
      // Scope: only inside the PostPress AI page (avoid WP admin sidebar, etc.)
      var scope =
        document.querySelector('#ppa-composer') ||
        document.querySelector('.ppa-composer') ||
        document.querySelector('.postpress-ai-composer') ||
        document.querySelector('#wpbody-content') ||
        document;

      // 1) Remove ALL existing help icons first (prevents duplicates forever)
      scope.querySelectorAll('.ppa-help-icon').forEach(function(n){ n.remove(); });

      // 2) Tooltip singleton
      var tooltipEl = document.getElementById('ppa-tooltip');
      if (!tooltipEl) {
        tooltipEl = document.createElement('div');
        tooltipEl.id = 'ppa-tooltip';
        tooltipEl.className = 'ppa-tooltip';
        tooltipEl.style.display = 'none';
        tooltipEl.innerHTML = '<div class="ppa-tooltip-inner"></div>';
        document.body.appendChild(tooltipEl);
      }
      var inner = tooltipEl.querySelector('.ppa-tooltip-inner');
      var openFor = null;

      function closeTooltip(){
        tooltipEl.style.display = 'none';
        tooltipEl.style.visibility = 'visible';
        openFor = null;
      }

      function positionTooltip(anchor){
        var rect = anchor.getBoundingClientRect();
        var scrollX = window.scrollX || window.pageXOffset || 0;
        var scrollY = window.scrollY || window.pageYOffset || 0;

        tooltipEl.style.display = 'block';
        tooltipEl.style.visibility = 'hidden';

        var left = rect.left + scrollX;
        var topBelow = rect.bottom + scrollY + 8;

        tooltipEl.style.left = left + 'px';
        tooltipEl.style.top = topBelow + 'px';

        var ttRect = tooltipEl.getBoundingClientRect();
        var minLeft = scrollX + 12;
        var maxLeft = scrollX + window.innerWidth - ttRect.width - 12;

        if (left > maxLeft) left = maxLeft;
        if (left < minLeft) left = minLeft;

        var viewportBottom = scrollY + window.innerHeight - 12;
        var top = topBelow;
        if (topBelow + ttRect.height > viewportBottom) {
          top = rect.top + scrollY - ttRect.height - 8;
        }
        if (top < scrollY + 12) top = scrollY + 12;

        tooltipEl.style.left = left + 'px';
        tooltipEl.style.top = top + 'px';

        var anchorCenterX = rect.left + (rect.width / 2) + scrollX;
        var arrowLeft = anchorCenterX - left - 5; // center 10px arrow
        if (arrowLeft < 14) arrowLeft = 14;
        if (arrowLeft > ttRect.width - 24) arrowLeft = ttRect.width - 24;
        tooltipEl.style.setProperty('--ppa-tip-arrow-left', arrowLeft + 'px');

        tooltipEl.style.visibility = 'visible';
      }

      function attach(labelEl, labelText){
        if (!labelEl) return;
        if (labelEl.querySelector && labelEl.querySelector('.ppa-help-icon')) return;

        labelEl.classList.add('ppa-has-help');

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'ppa-help-icon';
        btn.setAttribute('aria-label', labelText + ' help');
        btn.textContent = '?';

        btn.addEventListener('click', function(e){
          e.preventDefault();
          e.stopPropagation();
          if (openFor === btn) { closeTooltip(); return; }
          openFor = btn;
          inner.textContent = getHelp(labelText);
          positionTooltip(btn);
        });

        labelEl.appendChild(btn);
      }

      function findTitleEl(variants){
        var wants = variants.map(norm);
        var nodes = scope.querySelectorAll('label, .ppa-field-label, .ppa-label, .ppa-field-title, .field-title, strong, h4, h3');
        var best = null;

        for (var i=0;i<nodes.length;i++){
          var el = nodes[i];
          if (!el || !el.textContent) continue;

          // Only treat as title if it is near a real field
          var box = el.closest('.ppa-field, .ppa-form-group, .form-field, .field, .ppa-row, .ppa-col') || el.parentElement;
          if (!box) continue;
          if (!box.querySelector('input, select, textarea')) continue;

          var t = norm(el.textContent);
          if (!t) continue;
          if (wants.indexOf(t) === -1) continue;

          best = el;
          break;
        }
        return best;
      }

      // 3) Attach ONE tooltip per field label (explicit list = no accidental duplicates)
      var fields = [
        { variants: ['Industry'], label: 'Industry' },
        { variants: ['Subject / Title','Subject /  Title','Subject /  \nTitle'], label: 'Subject / Title' },
        { variants: ['Target audience'], label: 'Target audience' },
        { variants: ['Genre Select','Genre'], label: 'Genre Select' },
        { variants: ['Tone'], label: 'Tone' },
        { variants: ['Word Count (Preview)','Word Count  (Preview)','Word Count\n(Preview)'], label: 'Word Count (Preview)' },
        { variants: ['Optional brief / extra instructions'], label: 'Optional brief / extra instructions' },
        { variants: ['Advanced (optional)'], label: 'Advanced (optional)' },
        { variants: ['Language'], label: 'Language' },
        { variants: ['Show Outline'], label: 'Show Outline' }
      ];

      fields.forEach(function(f){
        var el = findTitleEl(f.variants);
        attach(el, f.label);
      });

      // 4) Genre cleanup: remove ALL genre microcopy + remove Clear button (DOM)
      var genreInput = scope.querySelector('input[placeholder="Search genres..."]');
      if (genreInput) {
        var box = genreInput.closest('.ppa-field, .ppa-form-group, .form-field, .field, .ppa-row, .ppa-col') || genreInput.parentElement;
        if (box) {
          // remove any helper text blocks inside genre section
          box.querySelectorAll('p, small, em, .description, .help, .ppa-help-text').forEach(function(n){
            var txt = (n.textContent || '').trim();
            if (!txt) return;
            n.remove();
          });

          // remove Clear button(s) inside genre section
          box.querySelectorAll('button, a').forEach(function(b){
            var t = (b.textContent || '').trim().toLowerCase();
            if (t === 'clear' || b.id === 'ppa-genre-clear-btn' || b.classList.contains('ppa-genre-clear-btn')) b.remove();
          });
        }
      }

      // extra safety: remove Clear button anywhere
      document.querySelectorAll('#ppa-genre-clear-btn, .ppa-genre-clear-btn').forEach(function(n){ n.remove(); });
      scope.querySelectorAll('button').forEach(function(b){
        if ((b.textContent || '').trim().toLowerCase() === 'clear') b.remove();
      });

      // 5) Close behaviors
      document.addEventListener('click', function(e){
        if (tooltipEl.style.display === 'none') return;
        if (tooltipEl.contains(e.target)) return;
        if (openFor && openFor.contains && openFor.contains(e.target)) return;
        closeTooltip();
      });

      document.addEventListener('keydown', function(e){
        if (e.key === 'Escape') closeTooltip();
      });

      window.addEventListener('scroll', function(){
        if (tooltipEl.style.display !== 'none') closeTooltip();
      }, true);

      window.addEventListener('resize', function(){
        if (tooltipEl.style.display !== 'none') closeTooltip();
      });

    } catch (err) {
      if (window.console && console.warn) console.warn('PPA UI cleanup init failed', err);
    }
  });
})();

