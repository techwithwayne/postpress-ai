(function($, win, doc) {
  'use strict';

  var didInit = false;

  function cleanUrl(url) {
    return String(url || '').replace(/^https?:\/\//, '').replace(/\/$/, '');
  }

  function getWpNonce() {
    if (win.postpressAi && win.postpressAi.nonce) return String(win.postpressAi.nonce).trim();
    if (win.ppaAdmin && win.ppaAdmin.wpNonce) return String(win.ppaAdmin.wpNonce).trim();
    if (win.ppaAdmin && win.ppaAdmin.nonce) return String(win.ppaAdmin.nonce).trim();
    if (win.PPA && win.PPA.wpNonce) return String(win.PPA.wpNonce).trim();
    if (win.PPA && win.PPA.nonce) return String(win.PPA.nonce).trim();

    var composer = doc.querySelector('[data-ppa-nonce]');
    if (composer) {
      var n = composer.getAttribute('data-ppa-nonce');
      if (n) return String(n).trim();
    }

    var hidden = doc.getElementById('ppa-nonce');
    if (hidden && hidden.value) return String(hidden.value).trim();

    return '';
  }

  function getRestBase() {
    if (win.postpressAi && win.postpressAi.restBase) return String(win.postpressAi.restBase).replace(/\/?$/, '/');
    if (win.wpApiSettings && win.wpApiSettings.root) return String(win.wpApiSettings.root).replace(/\/?$/, '/');
    if (win.ppaAdmin && win.ppaAdmin.restUrl) return String(win.ppaAdmin.restUrl).replace(/\/?$/, '/');
    if (win.PPA && win.PPA.restUrl) return String(win.PPA.restUrl).replace(/\/?$/, '/');
    return '/wp-json/';
  }

  function normalizeSite(site) {
    site = site || {};
    return {
      site_id: site.site_id || site.id || 'current',
      name: site.name || '',
      url: cleanUrl(site.url || ''),
      link: site.link || site.url || ''
    };
  }

  function siteFromOption($option, fallback) {
    if (!$option || !$option.length) {
      return normalizeSite(fallback);
    }

    return normalizeSite({
      site_id: $option.val() || 'current',
      name: $option.attr('data-site-name') || '',
      url: $option.attr('data-site-url') || '',
      link: $option.attr('data-site-link') || ''
    });
  }

  function ensureStyles() {
    if (doc.getElementById('ppa-remote-drafts-inline-style')) return;

    var css = [
      '#ppa-draft-destination-stack{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;width:100%;max-width:760px;margin:0 auto 20px;text-align:center;}',
      '#ppa-draft-destination-label{font-size:12px;letter-spacing:.18em;text-transform:uppercase;opacity:.9;}',
      '#ppa-draft-destination-copy{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-align:center;}',
      '#ppa-target-site-link{display:block;font-size:clamp(28px,4vw,54px);font-weight:700;line-height:1.05;text-align:center;text-decoration:none;}',
      '#ppa-target-site-link.is-static{pointer-events:none;text-decoration:none;}',
      '#ppa-target-site-url{display:inline-flex;align-items:center;justify-content:center;padding:8px 14px;border-radius:999px;text-align:center;}',
      '#ppa-draft-destination-select{width:100%;display:flex;justify-content:center;}',
      '#postpress-ai-target-site{width:min(520px,100%);max-width:100%;margin:0 auto;text-align:center;}',
      '@media (max-width: 782px){#ppa-target-site-link{font-size:36px;}#postpress-ai-target-site{width:100%;}}'
    ].join('');

    var style = doc.createElement('style');
    style.id = 'ppa-remote-drafts-inline-style';
    style.appendChild(doc.createTextNode(css));
    doc.head.appendChild(style);
  }

  function ensureCenteredStack($targetSelect) {
    if (!$targetSelect || !$targetSelect.length) return;

    ensureStyles();

    var selectEl = $targetSelect[0];
    var linkEl   = doc.getElementById('ppa-target-site-link');
    var urlEl    = doc.getElementById('ppa-target-site-url');

    if (!selectEl || !linkEl || !urlEl) {
      return;
    }

    var stack = doc.getElementById('ppa-draft-destination-stack');
    if (!stack) {
      stack = doc.createElement('div');
      stack.id = 'ppa-draft-destination-stack';

      var label = doc.createElement('div');
      label.id = 'ppa-draft-destination-label';
      label.textContent = 'Draft to';

      var copy = doc.createElement('div');
      copy.id = 'ppa-draft-destination-copy';

      var selectWrap = doc.createElement('div');
      selectWrap.id = 'ppa-draft-destination-select';

      stack.appendChild(label);
      stack.appendChild(copy);
      stack.appendChild(selectWrap);

      var anchor =
        selectEl.closest('.postpress-ai-target-site-wrap') ||
        selectEl.parentElement;

      if (anchor && anchor.parentNode) {
        anchor.parentNode.insertBefore(stack, anchor);
      } else {
        selectEl.parentNode.insertBefore(stack, selectEl);
      }
    }

    var copyWrap   = doc.getElementById('ppa-draft-destination-copy');
    var selectWrap = doc.getElementById('ppa-draft-destination-select');

    if (copyWrap && linkEl.parentNode !== copyWrap) {
      copyWrap.appendChild(linkEl);
    }

    if (copyWrap && urlEl.parentNode !== copyWrap) {
      copyWrap.appendChild(urlEl);
    }

    if (selectWrap && selectEl.parentNode !== selectWrap) {
      selectWrap.appendChild(selectEl);
    }

    Array.prototype.forEach.call(doc.querySelectorAll('label[for="postpress-ai-target-site"]'), function(el) {
      el.style.display = 'none';
    });

    Array.prototype.forEach.call(doc.querySelectorAll('*'), function(el) {
      if (
        el.id !== 'ppa-draft-destination-label' &&
        el.textContent &&
        el.textContent.trim() === 'Draft to'
      ) {
        el.style.display = 'none';
      }
    });
  }

  function updateDestinationDisplay(site) {
    site = normalizeSite(site);

    var $link = $('#ppa-target-site-link');
    var $url  = $('#ppa-target-site-url');

    if (!$link.length || !$url.length) {
      return;
    }

    var siteName = site.name || site.url || 'This site';
    var siteUrl  = cleanUrl(site.url || '');
    var siteLink = site.link || '';

    $link.text(siteName);

    if (siteLink) {
      $link
        .attr('href', siteLink)
        .attr('target', '_blank')
        .attr('rel', 'noopener noreferrer')
        .removeClass('is-static');
    } else {
      $link
        .removeAttr('href')
        .removeAttr('target')
        .removeAttr('rel')
        .addClass('is-static');
    }

    if (siteUrl) {
      $url.text(siteUrl).show();
    } else {
      $url.text('').hide();
    }
  }

  function loadSites() {
    var restBase = getRestBase();
    var nonce    = getWpNonce();

    console.info('PPA remote drafts: loadSites()', {
      restBase: restBase,
      noncePresent: !!nonce
    });

    return $.ajax({
      url: restBase.replace(/\/?$/, '/') + 'postpress-ai/v1/sites',
      method: 'GET',
      beforeSend: function(xhr) {
        if (nonce) xhr.setRequestHeader('X-WP-Nonce', nonce);
        if (nonce) xhr.setRequestHeader('X-PPA-Nonce', nonce);
      }
    });
  }

  function collectComposerPayload() {
    if (typeof win.postpressAiCollectComposerPayload === 'function') {
      return win.postpressAiCollectComposerPayload();
    }

    var subject = $('#ppa-subject').val() || '';
    var title   = $('#ppa-title').val() || subject;
    var excerpt = $('#ppa-excerpt').val() || '';
    var slug    = $('#ppa-slug').val() || '';

    var previewHtml = '';
    var previewPane = doc.getElementById('ppa-preview-pane');
    if (previewPane) {
      previewHtml = previewPane.innerHTML || '';
    }

    return {
      post_title: title,
      post_content: previewHtml,
      post_excerpt: excerpt,
      post_type: 'post',
      meta: slug ? { ppa_slug: slug } : {}
    };
  }

  function showNotice(message, type) {
    if (typeof win.postpressAiShowNotice === 'function') {
      win.postpressAiShowNotice(message, type);
      return;
    }

    var $msg = $('#ppa-toolbar-msg');
    if (!$msg.length) return;

    $msg
      .removeClass('is-error is-success is-warning')
      .addClass(type === 'error' ? 'is-error' : 'is-success')
      .text(message || '');
  }

  function sendRemoteDraft(payload, targetSiteId) {
    var restBase = getRestBase();
    var nonce    = getWpNonce();

    console.info('PPA remote drafts: sendRemoteDraft()', {
      restBase: restBase,
      targetSiteId: targetSiteId,
      noncePresent: !!nonce
    });

    return $.ajax({
      url: restBase.replace(/\/?$/, '/') + 'postpress-ai/v1/remote-draft-from-composer',
      method: 'POST',
      beforeSend: function(xhr) {
        if (nonce) xhr.setRequestHeader('X-WP-Nonce', nonce);
        if (nonce) xhr.setRequestHeader('X-PPA-Nonce', nonce);
      },
      contentType: 'application/json',
      data: JSON.stringify({
        target_site_id: targetSiteId,
        post_title: payload.post_title,
        post_content: payload.post_content,
        post_excerpt: payload.post_excerpt,
        post_type: payload.post_type,
        meta: payload.meta || {}
      })
    });
  }

  function bindSaveHandlers($targetSelect, currentSite) {
    $('#postpress-ai-save-draft, #ppa-draft')
      .off('.postpressRemoteDrafts')
      .on('click.postpressRemoteDrafts', function(e) {
        var targetSiteId = $targetSelect.val() || 'current';

        if (targetSiteId === 'current') {
          return;
        }

        e.preventDefault();
        e.stopImmediatePropagation();

        var payload = collectComposerPayload();

        if (!payload.post_title && !payload.post_content) {
          showNotice('Generate Preview first, then save to the selected site.', 'error');
          return false;
        }

        showNotice('Saving draft to selected site…', 'success');

        sendRemoteDraft(payload, targetSiteId)
          .done(function(response) {
            var msg = 'Draft saved on remote site.';
            if (response && response.target_site && response.target_site.url) {
              msg = 'Draft saved on ' + response.target_site.url + '.';
            }

            showNotice(msg, 'success');

            if (
              response &&
              response.remote_post &&
              response.remote_post.edit_link &&
              typeof win.postpressAiShowLinkNotice === 'function'
            ) {
              win.postpressAiShowLinkNotice(
                'Open remote draft in a new tab',
                response.remote_post.edit_link
              );
            } else if (response && response.remote_post && response.remote_post.edit_link) {
              win.open(response.remote_post.edit_link, '_blank', 'noopener');
            }
          })
          .fail(function(xhr) {
            var msg = 'Could not save draft to the selected site.';
            if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
              msg = xhr.responseJSON.message;
            }
            console.warn('PPA remote drafts: remote save failed.', xhr);
            showNotice(msg, 'error');
          });

        return false;
      });
  }

  function initRemoteDrafts() {
    var $targetSelect = $('#postpress-ai-target-site');

    if (!$targetSelect.length) {
      return;
    }

    if (didInit) {
      ensureCenteredStack($targetSelect);
      return;
    }
    didInit = true;

    ensureCenteredStack($targetSelect);

    var currentSite = normalizeSite({
      site_id: 'current',
      name: $targetSelect.attr('data-current-name') || 'This site',
      url: $targetSelect.attr('data-current-url') || '',
      link: $targetSelect.attr('data-current-link') || ''
    });

    var currentSiteUrl = cleanUrl(currentSite.url || '');

    updateDestinationDisplay(currentSite);

    $targetSelect.on('change.postpressRemoteDrafts', function() {
      updateDestinationDisplay(siteFromOption($(this).find('option:selected'), currentSite));
    });

    loadSites()
      .done(function(sites) {
        if (!Array.isArray(sites)) {
          console.warn('PPA remote drafts: /sites response was not an array.', sites);
          return;
        }

        $targetSelect.find('option').not('[value="current"]').remove();

        sites.forEach(function(site) {
          if (!site || site.site_id === 'current') {
            return;
          }

          var normalized = normalizeSite({
            site_id: site.site_id || site.id,
            name: site.name || site.url || site.site_id || site.id,
            url: site.url || '',
            link: site.url || ''
          });

          if (!normalized.site_id) {
            return;
          }

          if (currentSiteUrl && normalized.url === currentSiteUrl) {
            return;
          }

          if ($targetSelect.find('option[value="' + normalized.site_id + '"]').length) {
            return;
          }

          var label = normalized.name || normalized.url || normalized.site_id;
          if (normalized.url) {
            label += ' (' + normalized.url + ')';
          }

          $('<option>')
            .val(normalized.site_id)
            .text(label)
            .attr('data-site-name', normalized.name)
            .attr('data-site-url', normalized.url)
            .attr('data-site-link', normalized.link)
            .appendTo($targetSelect);
        });

        updateDestinationDisplay(
          siteFromOption($targetSelect.find('option:selected'), currentSite)
        );
      })
      .fail(function(xhr) {
        console.warn('PPA remote drafts: could not load sites.', xhr);
      });

    bindSaveHandlers($targetSelect, currentSite);

    console.info('PPA remote drafts: init complete', {
      selectFound: true,
      restBase: getRestBase(),
      noncePresent: !!getWpNonce()
    });
  }

  initRemoteDrafts();
  $(initRemoteDrafts);

})(jQuery, window, document);
