(function($, win, doc){
  'use strict';

  function strip(url){
    return String(url || '').replace(/^https?:\/\//,'').replace(/\/$/,'');
  }

  function haveApiFetch(){
    return !!(win.wp && win.wp.apiFetch);
  }

  function getCurrentFromSelect($sel){
    return {
      id: 'current',
      name: ($sel.attr('data-current-name') || 'This site'),
      url: strip($sel.attr('data-current-url') || strip(win.location.origin)),
      link: ($sel.attr('data-current-link') || (win.location.origin + '/'))
    };
  }

  function setHeader(site){
    if(!site) return;

    var $link = $('#ppa-target-site-link');
    var $url  = $('#ppa-target-site-url');

    if($link.length){
      $link.text(site.name || '');
      if(site.link){
        $link.attr('href', site.link).attr('target','_blank').attr('rel','noopener noreferrer');
      }
    }

    if($url.length){
      if(site.url){
        $url.text(site.url).show();
      } else {
        $url.text('').hide();
      }
    }
  }

  function buildSiteMap(sites, current){
    var map = {};
    map['current'] = current;

    (sites || []).forEach(function(s){
      if(!s) return;
      var id = String(s.site_id || '');
      if(!id) return;

      map[id] = {
        id: id,
        name: String(s.name || s.url || id),
        url: strip(s.url || ''),
        link: String(s.url || '')
      };
    });

    return map;
  }

  function hydrateSelect($sel, map){
    // remove remote options
    $sel.find('option').not('[value="current"]').remove();

    var currentHost = strip(win.location.origin);

    Object.keys(map).forEach(function(id){
      if(id === 'current') return;
      var s = map[id];
      if(!s) return;

      // filter duplicate of this same WP site
      if(s.url && s.url === currentHost) return;

      var $opt = $('<option/>')
        .val(id)
        .text(s.name)
        .attr('data-site-name', s.name)
        .attr('data-site-url', s.url)
        .attr('data-site-link', s.link);

      $sel.append($opt);
    });
  }

  function getSelectedSite($sel, map){
    var id = String($sel.val() || 'current');
    return map[id] || map['current'];
  }

  function collectPayload(){
    var title =
      ($('#ppa-title').val() || '').trim() ||
      ($('#ppa-subject').val() || '').trim() ||
      'Untitled';

    var content = '';
    var pane = doc.getElementById('ppa-preview-pane');
    if(pane) content = (pane.innerHTML || '').trim();

    var excerpt = ($('#ppa-excerpt').val() || '').trim();

    return {
      post_title: title,
      post_content: content,
      post_excerpt: excerpt,
      post_type: 'post',
      meta: {}
    };
  }

  function remoteSave(targetSiteId, payload){
    return win.wp.apiFetch({
      path: '/postpress-ai/v1/remote-draft-from-composer',
      method: 'POST',
      data: {
        target_site_id: targetSiteId,
        post_title: payload.post_title,
        post_content: payload.post_content,
        post_excerpt: payload.post_excerpt,
        post_type: payload.post_type,
        meta: payload.meta || {}
      }
    });
  }

  function bindRemoteSave($sel, map){
    $(doc).off('click.ppaRemoteDrafts');

    $(doc).on('click.ppaRemoteDrafts', '#ppa-draft, #postpress-ai-save-draft', function(e){
      var id = String($sel.val() || 'current');
      if(id === 'current') return; // let normal local save happen

      e.preventDefault();
      e.stopImmediatePropagation();

      var payload = collectPayload();
      if(!payload.post_content){
        console.warn('PPA remote drafts: no preview content. Generate Preview first.');
        return false;
      }

      remoteSave(id, payload)
        .then(function(resp){
          console.log('PPA remote drafts: remote save ok', resp);
          if(resp && resp.remote_post && resp.remote_post.edit_link){
            win.open(resp.remote_post.edit_link, '_blank', 'noopener');
          }
        })
        .catch(function(err){
          console.warn('PPA remote drafts: remote save failed', err);
        });

      return false;
    });
  }

  $(function(){
    var $sel = $('#postpress-ai-target-site');
    if(!$sel.length) return;

    if(!haveApiFetch()){
      console.warn('PPA remote drafts: wp.apiFetch missing on this screen.');
      return;
    }

    var current = getCurrentFromSelect($sel);

    // initial header
    setHeader(current);

    // load sites -> hydrate -> bind change
    win.wp.apiFetch({ path: '/postpress-ai/v1/sites' })
      .then(function(sites){
        var map = buildSiteMap(sites, current);
        hydrateSelect($sel, map);

        // set header to current selection
        setHeader(getSelectedSite($sel, map));

        // change handler ALWAYS updates header from map
        $sel.off('change.ppaRemoteDrafts').on('change.ppaRemoteDrafts', function(){
          setHeader(getSelectedSite($sel, map));
        });

        bindRemoteSave($sel, map);

        console.log('PPA remote drafts: hydrated + header sync ready');
      })
      .catch(function(err){
        console.warn('PPA remote drafts: /sites failed', err);
      });
  });

})(jQuery, window, document);
